# Copy to deploy.env and adjust if needed (deploy.env is gitignored).
GCP_PROJECT=jobifai-494014
GCP_ZONE=australia-southeast1-a
GCP_VM=jobifai-vm
GCP_REGION=australia-southeast1
IMAGE=australia-southeast1-docker.pkg.dev/jobifai-494014/jobifai/jobifai:latest
REMOTE_DIR=/opt/jobifai
# DEPLOY_BRANCH=main
# DEPLOY_REMOTE=origin

# ---------------------------------------------------------------------------
# The variables below must be set in /opt/jobifai/.env on the VM, NOT here.
# deploy.env controls the local deploy script; .env is the app/container env.
# ---------------------------------------------------------------------------

# Log format — required for structured JSON collection by Alloy.
# LOG_FORMAT=json
# JOBIFAI_ENV=production

# Grafana Cloud Loki — Connections → Add new connection → Loki
# URL must include the full push path ending in /loki/api/v1/push
# GRAFANA_LOKI_URL=https://logs-xxx.grafana.net/loki/api/v1/push
# GRAFANA_LOKI_USER=    # numeric tenant ID shown next to the endpoint URL
# GRAFANA_LOKI_API_KEY= # API key with Logs Push scope (not the Grafana admin key)
