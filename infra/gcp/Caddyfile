# Canonical host — avoids Google OAuth state cookie mismatch (www vs apex).
www.jobifai.com.au {
	redir https://jobifai.com.au{uri} permanent
}

jobifai.com.au {
	encode gzip
	reverse_proxy jobifai:8081
}

